# Desarrollo local (misma red WiFi que el backend):
EXPO_PUBLIC_API_URL=http://TU_IP_LOCAL:5000/api

# Una vez el backend esté desplegado (p.ej. en Render), usa esa URL en su
# lugar — así la app funciona desde cualquier red, no solo tu WiFi local:
# EXPO_PUBLIC_API_URL=https://tu-backend.onrender.com/api
